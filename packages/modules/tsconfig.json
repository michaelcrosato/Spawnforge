{
  "extends": "../../tsconfig.base.json",
  // No "dom" lib and no "node" types: modules must run unchanged in browsers, workers and Node.
  "compilerOptions": {
    "lib": ["es2023"],
    "types": []
  },
  "include": ["src"],
  // Tests run in Node; tsconfig.tests.json at the root checks them with Node types.
  "exclude": ["src/**/*.test.ts"]
}
