{
  "name": "@spawnforge/mcp",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server exposing the Spawnforge CLI commands as tools.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelcrosato/Spawnforge.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-docs.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@spawnforge/cli": "workspace:*",
    "@spawnforge/core": "workspace:*",
    "@spawnforge/render": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "bin": {
    "spawnforge-mcp": "./src/bin.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "spawnforge-mcp": "./dist/bin.js"
    }
  }
}
