{
  "name": "@spawnforge/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Spawnforge command line and headless renderer. Every command prints JSON.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelcrosato/Spawnforge.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "spawnforge": "./src/bin.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@spawnforge/core": "workspace:*",
    "@spawnforge/modules": "workspace:*",
    "@spawnforge/render": "workspace:*",
    "zod": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "spawnforge": "./dist/bin.js"
    }
  }
}
