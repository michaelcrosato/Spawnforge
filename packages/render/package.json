{
  "name": "@spawnforge/render",
  "version": "0.2.0",
  "private": true,
  "description": "Headless renders of creatures: contact sheets and filmstrips as PNG, through Chromium.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelcrosato/Spawnforge.git",
    "directory": "packages/render"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "page"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p page/tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@spawnforge/bake": "workspace:*",
    "@spawnforge/core": "workspace:*",
    "@spawnforge/modules": "workspace:*",
    "@spawnforge/three": "workspace:*",
    "playwright-core": "1.63.0",
    "three": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/three": "catalog:",
    "gltf-validator": "2.0.0-dev.3.10"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
